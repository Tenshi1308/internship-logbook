# Neon PostgreSQL
# Pooled connection string (used by the application at runtime).
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Direct connection string (used by the Prisma CLI for migrations).
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# Auth.js secret (generate with: openssl rand -base64 32)
AUTH_SECRET=""

# GitHub OAuth App (optional GitHub evidence integration)
# Register an OAuth App at https://github.com/settings/developers
# Callback URL: {AUTH_URL-origin}/api/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Key used to encrypt GitHub access tokens at rest (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=""

# AI-assisted description (optional LLM integration)
# OpenAI-compatible chat completions endpoint. Leave empty to disable the
# feature; the report editor still works manually.
AI_API_KEY=""
AI_API_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# Documentation photos (optional Cloudinary integration)
# Upload to https://cloudinary.com/console. Leave empty to disable the photo
# gallery; the report editor still works. The API secret is NEVER exposed to
# the browser; uploads are signed server-side.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional: override Cloudinary API base for tests/self-hosted mock.
CLOUDINARY_API_URL=""
